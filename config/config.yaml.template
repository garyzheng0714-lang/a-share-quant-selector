# ============================================
# A股量化选股系统 - 主配置文件模板
# ============================================
# 使用说明：
# 1. 复制此文件为 config.yaml 只保存非敏感开关
# 2. token、API Key、webhook 和签名密钥只能通过环境变量/密钥文件注入
# 3. 不要提交 config.yaml（已加入 .gitignore 和 .dockerignore）

data_dir: data

# 数据更新配置
update:
  lookback_days: 10
  skip_failed: true

# 大模型配置（可选）：只用于候选解释与公告风险标签，不参与自由荐股或排序。
# provider=ark 时 model 必须填写火山方舟接入点 ID（ep-...）；
# provider=anthropic 时 model 可留空使用代码默认值。
# API Key 不写入本文件：Ark 使用 ARK_API_KEY，Anthropic 使用
# ANTHROPIC_API_KEY。未配置时解释功能停用，不影响规则决策。
llm:
  provider: "ark"  # ark | anthropic
  model: ""        # Ark: ep-...；Anthropic: 可选模型名
  base_url: "https://ark.cn-beijing.volces.com/api/v3"

# 分层决策：市场 → 板块 → 个股 → 执行
# 紧急回退也可设置 DECISION_HIERARCHY_ENABLED=false，无需修改文件。
decision:
  enabled: true
  strict_unvalidated_gate: true  # 市场/板块模型未通过走查时，只观察、不荐买
  preopen_event_check: true      # 08:45 复核隔夜公告；数据源失败则降级为观察
  weekly_gate_mode: "shadow"     # off | shadow | active；历史时点验证完成前保持 shadow
