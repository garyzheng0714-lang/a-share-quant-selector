# ============================================
# A股量化选股系统 - 主配置文件模板
# ============================================
# 使用说明：
# 1. 复制此文件为 config.yaml
# 2. 填入你的钉钉机器人配置
# 3. 不要提交 config.yaml 到Git仓库（已加入.gitignore）

data_dir: data

# 钉钉机器人配置
# 1. 在钉钉群中添加自定义机器人
# 2. 复制 webhook URL 和加签密钥
# 3. 填入下方（去掉引号内的占位符）
dingtalk:
  webhook_url: "https://oapi.dingtalk.com/robot/send?access_token=YOUR_TOKEN_HERE"
  secret: "YOUR_SECRET_HERE"

# 定时任务配置
schedule:
  time: "17:00"  # 每日执行时间

# 数据更新配置
update:
  lookback_days: 10
  skip_failed: true

# 大模型配置（仅用于有证据的事件分类与决策解释，可选；不参与自由荐股或排序）
# 1. 到 https://platform.claude.com 申请 API Key
# 2. 填入下方（或改用环境变量 ANTHROPIC_API_KEY）
# 3. 不配置时荐票功能自动停用，其他功能不受影响
llm:
  api_key: ""              # sk-ant-...
  model: "claude-opus-4-8" # 默认即可

# 分层决策：市场 → 板块 → 个股 → 执行
# 紧急回退也可设置 DECISION_HIERARCHY_ENABLED=false，无需修改文件。
decision:
  enabled: true
  strict_unvalidated_gate: true  # 市场/板块模型未通过走查时，只观察、不荐买
  preopen_event_check: true      # 08:45 复核隔夜公告；数据源失败则降级为观察
